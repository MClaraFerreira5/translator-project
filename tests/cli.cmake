set(pasta "${CMAKE_CURRENT_BINARY_DIR}/cli-fixtures")
file(MAKE_DIRECTORY "${pasta}/diretorio.oxe")
file(WRITE "${pasta}/entrada.oxe" "inteiro valor bota 1\n")
file(WRITE "${pasta}/entrada.txt" "referência\n")
set(contagem 0)
function(verificar nome codigo trecho)
  execute_process(COMMAND "${OXENTE}" ${ARGN}
    WORKING_DIRECTORY "${pasta}"
    RESULT_VARIABLE retorno OUTPUT_VARIABLE saida ERROR_VARIABLE erro)
  if(NOT "${retorno}" STREQUAL "${codigo}")
    message(FATAL_ERROR "${nome}: esperado ${codigo}, obtido ${retorno}: ${erro}")
  endif()
  if(codigo EQUAL 0)
    if(NOT erro STREQUAL "" OR NOT saida MATCHES "${trecho}")
      message(FATAL_ERROR "${nome}: ajuda ou canais incorretos")
    endif()
  else()
    if(NOT saida STREQUAL "" OR NOT erro MATCHES "${trecho}")
      message(FATAL_ERROR "${nome}: diagnóstico ou canais incorretos: ${erro}")
    endif()
  endif()
  math(EXPR total "${contagem}+1")
  set(contagem ${total} PARENT_SCOPE)
endfunction()
verificar(ajuda 0 "Uso:" --help)
verificar(desconhecida 2 "desconhecida" --inexistente)
verificar(sem_argumentos 2 "modo explícito")
verificar(sem_modo 2 "modo explícito" entrada.oxe)
verificar(sem_entrada 2 "falta arquivo" --check)
verificar(inexistente 3 "inexistente" --check ausente.oxe)
verificar(extensao 2 "extensão" --check entrada.txt)
verificar(diretorio 3 "regular" --check diretorio.oxe)
verificar(dois_modos 2 "apenas um modo" --check --dump-ast entrada.oxe)
verificar(modo_repetido 2 "apenas um modo" --check --check entrada.oxe)
verificar(duas_entradas 2 "apenas um arquivo" --check entrada.oxe entrada.oxe)
verificar(ajuda_incompativel 2 "incompatível" --help --check entrada.oxe)
verificar(sem_saida 2 "falta caminho" --emit-python entrada.oxe -o)
verificar(opcao_como_saida 2 "falta caminho" --emit-python entrada.oxe -o --check)
verificar(saida_repetida 2 "repetida" --emit-python entrada.oxe -o a.py --output b.py)
verificar(saida_check 2 "exige" --check entrada.oxe -o a.py)
verificar(saida_ast 2 "exige" --dump-ast entrada.oxe -o a.ast)
foreach(modo IN ITEMS --check --dump-ast --emit-python)
  verificar("pendente_${modo}" 4 "não implementado" ${modo} entrada.oxe)
endforeach()
file(REMOVE "${pasta}/saida.py")
verificar(emissao_saida 4 "não implementado" --emit-python entrada.oxe -o saida.py)
if(EXISTS "${pasta}/saida.py")
  message(FATAL_ERROR "Modo pendente criou saída")
endif()
file(WRITE "${pasta}/preservar.py" "conteúdo preexistente\n")
verificar(preservar_saida 4 "não implementado" --output preservar.py entrada.oxe --emit-python)
file(READ "${pasta}/preservar.py" conteudo)
if(NOT conteudo STREQUAL "conteúdo preexistente\n")
  message(FATAL_ERROR "Modo pendente alterou saída preexistente")
endif()
file(READ "${pasta}/entrada.oxe" original)
verificar(saida_igual_entrada 4 "não implementado" --emit-python entrada.oxe -o entrada.oxe)
file(READ "${pasta}/entrada.oxe" depois)
if(NOT original STREQUAL depois)
  message(FATAL_ERROR "Entrada sobrescrita")
endif()
file(WRITE "${pasta}/-entrada.oxe" "referência\n")
verificar(fim_opcoes 4 "não implementado" --check -- -entrada.oxe)
file(GLOB produtos "${pasta}/*.ast")
if(produtos)
  message(FATAL_ERROR "AST fictícia criada")
endif()
message(STATUS "${contagem} cenários de CLI verificados")
