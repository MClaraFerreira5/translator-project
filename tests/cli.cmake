file(WRITE "${pasta}/entrada.txt" "referência\n")
set(contagem 0)
function(verificar nome codigo trecho)
  execute_process(COMMAND "${OXENTE}" ${ARGN}
    WORKING_DIRECTORY "${pasta}"
    RESULT_VARIABLE retorno OUTPUT_VARIABLE saida ERROR_VARIABLE erro)
  if(NOT "${retorno}" STREQUAL "${codigo}")
    message(FATAL_ERROR "${nome}: esperado ${codigo}, obtido ${retorno}: ${erro}")
  endif()
  if(codigo EQUAL 0)
    if(NOT erro STREQUAL "" OR NOT saida MATCHES "${trecho}")
      message(FATAL_ERROR "${nome}: ajuda ou canais incorretos")
    endif()
  else()
    if(NOT saida STREQUAL "" OR NOT erro MATCHES "${trecho}")
      message(FATAL_ERROR "${nome}: diagnóstico ou canais incorretos: ${erro}")
    endif()
  endif()
  math(EXPR total "${contagem}+1")
  set(contagem ${total} PARENT_SCOPE)
endfunction()
verificar(ajuda 0 "Uso:" --help)
